<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear/>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
        <add key="ClassIsland" value="https://www.myget.org/F/classisland/api/v3/index.json" protocolVersion="3"/>
        <!-- Jint 5 目前只有预览版，发在这个 feed 上 -->
        <add key="Jint-preview" value="https://f.feedz.io/sebastienros/jint/nuget/index.json" protocolVersion="3"/>
        <!--
            ClassIsland 的 misha dev 构建（2.1.1.1-misha-dev3225）没有公开发布，随仓库自带，
            以保证本地构建与 CI 使用同一套 SDK。相对路径相对本文件所在目录解析。
            升级方式见 nuget-local/README.md。
        -->
        <add key="LocalPackages" value="nuget-local"/>
    </packageSources>
</configuration>