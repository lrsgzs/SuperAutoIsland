<ci:ActionSettingsControlBase xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:ci="http://classisland.tech/schemas/xaml/core"
                              xmlns:local="clr-namespace:SuperAutoIsland.Controls.ActionSettingsControls"
                              xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                              xmlns:enums="clr-namespace:SuperAutoIsland.Enums"
                              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                              x:Class="SuperAutoIsland.Controls.ActionSettingsControls.ConfirmExecuteActionSettingsControl"
                              x:Name="Root">
    <ci:ActionSettingsControlBase.Resources>
        <ScrollViewer x:Key="SettingsDrawer"
                      x:DataType="local:ConfirmExecuteActionSettingsControl"
                      Width="512">
            <StackPanel Orientation="Vertical" Spacing="8">
                <TextBlock Text="工作流执行确认 对话框设置"
                           TextWrapping="Wrap"
                           Theme="{DynamicResource TitleTextBlockStyle}" />

                <GroupBox Header="内容">
                    <StackPanel Orientation="Vertical" Spacing="4">
                        <ci:Field Label="标题">
                            <TextBox Text="{Binding ActionSettings.Header}" />
                        </ci:Field>

                        <ci:Field Label="消息">
                            <TextBox Text="{Binding ActionSettings.Message}" />
                        </ci:Field>
                        
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            格式化变量说明：<LineBreak />
                            {name}：当前工作流名称
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="交互">
                    <StackPanel Orientation="Vertical" Spacing="4">
                        <ci:Field Label="「Yes」按钮文本">
                            <TextBox Text="{Binding ActionSettings.YesText}" />
                        </ci:Field>

                        <ci:Field Label="「No」按钮文本">
                            <TextBox Text="{Binding ActionSettings.NoText}" />
                        </ci:Field>

                        <CheckBox Content="默认按钮为「Yes」？" IsChecked="{Binding ActionSettings.PreferYes}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="行为">
                    <StackPanel Orientation="Vertical" Spacing="4">
                        <CheckBox Content="置顶对话框？" IsChecked="{Binding ActionSettings.Topmost}" />
                        
                        <CheckBox Content="启用倒计时？" IsChecked="{Binding ActionSettings.CountdownEnabled}" />
                        
                        <ci:Field Label="倒计时模式">
                            <ComboBox SelectedIndex="{Binding ActionSettings.CountdownMode}">
                                <ComboBoxItem Content="可交互前倒计时" />
                                <ComboBoxItem Content="自动 Yes 倒计时" />
                                <ComboBoxItem Content="自动 No 倒计时" />
                            </ComboBox>
                        </ci:Field>

                        <TextBlock Text="启用倒计时后，该对话框将会在倒计时期间，拦截包括关闭在内的交互，倒计时结束后即恢复。请谨慎启用。"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ActionSettings.CountdownMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:CountdownMode.Enable}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="启用倒计时后，该对话框将会在倒计时结束后，自动触发「Yes」行为。"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ActionSettings.CountdownMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:CountdownMode.Resolve}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="启用倒计时后，该对话框将会在倒计时结束后，自动触发「No」行为。"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ActionSettings.CountdownMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:CountdownMode.Reject}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <ci:Field Label="倒计时时长" Suffix="s">
                            <fa:FANumberBox Minimum="0" Maximum="60"
                                            SmallChange="1" LargeChange="5"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{Binding ActionSettings.CountdownTime}" />
                        </ci:Field>
                    </StackPanel>
                </GroupBox>
                
                <GroupBox Header="延时">
                    <StackPanel Orientation="Vertical" Spacing="4">
                        <CheckBox Content="允许延时运行？" IsChecked="{Binding ActionSettings.CanDelay}" />
                    
                        <ci:Field Label="延时时长" Suffix="s">
                            <fa:FANumberBox Minimum="0" Maximum="60"
                                            SmallChange="1" LargeChange="5"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{Binding ActionSettings.DefaultDelayTime}" />
                        </ci:Field>
                        
                        <ci:Field Label="「Delay」按钮文本">
                            <TextBox Text="{Binding ActionSettings.DelayText}" />
                        </ci:Field>

                        <ci:Field Label="延时执行弹窗文本">
                            <TextBox Text="{Binding ActionSettings.DelayDescription}" />
                        </ci:Field>
                    </StackPanel>
                </GroupBox>

                <Button Content="预览" Classes="accent"
                        Click="PreviewButton_OnClick" />

                <TextBlock Text="SAI 开发者不对滥用对话框的行为负责。"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
    </ci:ActionSettingsControlBase.Resources>

    <Grid ColumnDefinitions="Auto *" ColumnSpacing="8"
          DataContext="{Binding #Root}">
        <Button Grid.Column="0"
                VerticalAlignment="Center"
                Theme="{DynamicResource TransparentButton}"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Click="ShowSettingsButton_OnClick">
            <ci:IconText Glyph="{ci:FI SettingsRegular}" Text="打开设置" />
        </Button>
        
        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    VerticalAlignment="Center"
                    Spacing="4">
            <TextBlock x:Name="HeaderTextBlock"
                       FontSize="12" TextTrimming="WordEllipsis"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="MessageTextBlock"
                       FontSize="12" TextTrimming="WordEllipsis"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</ci:ActionSettingsControlBase>
