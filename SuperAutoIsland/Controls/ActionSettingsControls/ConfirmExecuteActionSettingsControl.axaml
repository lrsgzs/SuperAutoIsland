<ci:ActionSettingsControlBase xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:ci="http://classisland.tech/schemas/xaml/core"
                              xmlns:local="clr-namespace:SuperAutoIsland.Controls.ActionSettingsControls"
                              xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                              xmlns:enums="clr-namespace:SuperAutoIsland.Enums"
                              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                              x:Class="SuperAutoIsland.Controls.ActionSettingsControls.ConfirmExecuteActionSettingsControl"
                              x:Name="Root">
    <ci:ActionSettingsControlBase.Resources>
    </ci:ActionSettingsControlBase.Resources>

    <Grid ColumnDefinitions="Auto *" ColumnSpacing="8"
          DataContext="{Binding #Root}">
        <Button Grid.Column="0"
                VerticalAlignment="Center"
                Theme="{DynamicResource TransparentButton}"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Click="ShowSettingsButton_OnClick">
            <ci:IconText Glyph="{ci:FI SettingsRegular}" Text="打开设置" />
        </Button>

        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    VerticalAlignment="Center"
                    Spacing="4">
            <TextBlock x:Name="HeaderTextBlock"
                       FontSize="12" TextTrimming="WordEllipsis"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="MessageTextBlock"
                       FontSize="12" TextTrimming="WordEllipsis"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</ci:ActionSettingsControlBase>