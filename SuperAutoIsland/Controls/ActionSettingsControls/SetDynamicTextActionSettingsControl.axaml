<ci:ActionSettingsControlBase x:Class="SuperAutoIsland.Controls.ActionSettingsControls.SetDynamicTextActionSettingsControl"
                              x:TypeArguments="actionSettings:SetDynamicTextActionSettings"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:ci="http://classisland.tech/schemas/xaml/core"
                              xmlns:local="clr-namespace:SuperAutoIsland.Controls.ActionSettingsControls"
                              xmlns:actionSettings="clr-namespace:SuperAutoIsland.Models.Actions">
    <Panel DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:SetDynamicTextActionSettingsControl}}">
        <Grid RowDefinitions="*, *" ColumnDefinitions="Auto, *" RowSpacing="4" ColumnSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="将" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{ReflectionBinding Settings.Key}" />
            
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="修改为" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{ReflectionBinding Settings.Value}" />
        </Grid>
    </Panel>
</ci:ActionSettingsControlBase>