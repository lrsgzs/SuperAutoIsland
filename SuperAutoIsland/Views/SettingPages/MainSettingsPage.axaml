<ci:SettingsPageBase x:Class="SuperAutoIsland.Views.SettingPages.MainSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:settingPages="clr-namespace:SuperAutoIsland.Views.SettingPages"
                     mc:Ignorable="d">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=settingPages:MainSettingsPage}}">
        <StackPanel Classes="settings-container animated-intro">
            <fa:FAInfoBar IsOpen="True" IsClosable="False" Severity="Informational">
                <fa:FAInfoBar.Message>
                    欢迎使用 SuperAutoIsland！本插件使用了 Blockly，在此致谢。
                </fa:FAInfoBar.Message>
            </fa:FAInfoBar>
            
            <fa:FAInfoBar IsOpen="True"
                          IsClosable="False"
                          Severity="Informational"
                          Message="插件社区Q群 ClassIsPlugin 现已建立！点击按钮，即刻加入！">
                <fa:FAInfoBar.ActionButton>
                    <Button Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                            CommandParameter="https://qm.qq.com/q/PeyliibxE4"
                            Content="加入群组" />
                </fa:FAInfoBar.ActionButton>
            </fa:FAInfoBar>
        
            <fa:FASettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xEEF5;}" Header="日志" Description="查看日志呗">
                <fa:FASettingsExpander.Footer>
                    <Button Margin="3,0,6,0"
                            HorizontalContentAlignment="Center"
                            Click="ViewLogsButton_OnClick"
                            Content="查看日志"/>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            
            <fa:FASettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xEF1F;}" Header="端口号" Description="服务器端口号">
                <fa:FASettingsExpander.Footer>
                    <TextBox MinWidth="64"
                             InputMethod.IsInputMethodEnabled="False"
                             Text="{Binding Settings.ServerPort, Mode=TwoWay}"/>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            
            <fa:FASettingsExpander IconSource="{ci:FluentIconSource Glyph={ci:FI DocumentRegular}}"
                                   Header="启用档案功能"
                                   Description="指定是否启用档案功能。当前为 Blockly 独占功能">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.EnableProfileFeatures}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            
            <fa:FASettingsExpander IconSource="{ci:FluentIconSource {ci:FI BugRegular}}" Header="调试" Description="查看行动元数据" IsVisible="False">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox x:Name="DebugComboBox" />
                        <Button Click="DebugGetInfo_OnClick">debug!</Button>
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
                
                <fa:FASettingsExpanderItem>
                    <TextBox x:Name="DebugTextBox" AcceptsReturn="True" AcceptsTab="True" />
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>