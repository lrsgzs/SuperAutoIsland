<ci:SettingsPageBase x:Class="SuperAutoIsland.Views.SettingPages.BlocklySettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:settingPages="clr-namespace:SuperAutoIsland.Views.SettingPages"
                     xmlns:controls="clr-namespace:SuperAutoIsland.Controls"
                     mc:Ignorable="d">
    <Grid RowDefinitions="Auto *"
          DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=settingPages:BlocklySettingsPage}}">
        <Grid Grid.Row="0"
              Margin="12 16 18 0"
              MaxWidth="{StaticResource SettingsContainerWidth}">
            <TextBlock Text="SAI Blockly 设置" FontWeight="Normal"
                       Theme="{StaticResource TitleTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Classes="settings-container animated-intro">
                <fa:FASettingsExpander IconSource="{ci:FluentIconSource Glyph={ci:FI AppsListDetailRegular}}"
                                       Header="管理积木分类"
                                       Description="调整 Blockly 工具箱里的分类显示。"
                                       ActionIconSource="{ci:FluentIconSource &#xEC2E;}"
                                       IsClickEnabled="True"
                                       Click="ManageCategoriesButton_OnClick">
                </fa:FASettingsExpander>

                <Separator Margin="0 12 0 4" />
                <ci:IconText Glyph="{ci:FI AppsRegular}" Text="实验性分类" Margin="0 0 0 4" />

                <fa:FASettingsExpander IconSource="{ci:FluentIconSource Glyph={ci:FI GroupRegular}}"
                                       Header="启用档案功能"
                                       Description="实验性功能。指定是否启用档案功能。目前为 Blockly 独占功能。修改此开关需要重启应用。"
                                       IsExpanded="{Binding Settings.EnableProfileFeatures, Mode=OneWay}">
                    <fa:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.EnableProfileFeatures}" />
                    </fa:FASettingsExpander.Footer>

                    <fa:FASettingsExpanderItem Content="要启用的档案功能部分"
                                               Description="此处更改无需重启即可生效，重新打开 Blockly 编辑器后可见。" />

                    <controls:ProfileFeatureToggle Label="科目"
                                                   Settings="{Binding Settings.ProfileFeatures.Subject}" />

                    <controls:ProfileFeatureToggle Label="时间点"
                                                   Settings="{Binding Settings.ProfileFeatures.TimePoint}" />

                    <controls:ProfileFeatureToggle Label="时间表"
                                                   Settings="{Binding Settings.ProfileFeatures.TimeLayout}" />

                    <controls:ProfileFeatureToggle Label="课表"
                                                   Settings="{Binding Settings.ProfileFeatures.ClassPlan}" />

                    <controls:ProfileFeatureToggle Label="课表群"
                                                   Settings="{Binding Settings.ProfileFeatures.ClassPlanGroup}" />

                    <controls:ProfileFeatureToggle Label="日程"
                                                   Settings="{Binding Settings.ProfileFeatures.Schedule}" />
                </fa:FASettingsExpander>

                <fa:FASettingsExpander IconSource="{ci:FluentIconSource Glyph={ci:FI AppsRegular}}"
                                       Header="应用设置积木"
                                       Description="实验性功能。把 ClassIsland 的应用设置转成 Blockly 积木。修改此开关需要重启应用。"
                                       IsExpanded="{Binding Settings.EnableAppSettingsBlocks, Mode=OneWay}">
                    <fa:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.EnableAppSettingsBlocks}" />
                    </fa:FASettingsExpander.Footer>

                    <fa:FASettingsExpanderItem Content="选择要展示的设置项…"
                                               Description="此处更改无需重启即可生效，刷新 Blockly 编辑器后可见。"
                                               ActionIconSource="{ci:FluentIconSource &#xEC2E;}"
                                               IsClickEnabled="True"
                                               Click="SelectAppSettingsButton_OnClick" />

                    <TextBlock Margin="0 4 0 0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="⚠ 实验性功能：应用设置积木会直接修改 ClassIsland 的应用配置并立即生效，请谨慎使用。" />
                </fa:FASettingsExpander>

                <fa:FASettingsExpander IconSource="{ci:FluentIconSource Glyph={ci:FI WindowAppsRegular}}"
                                       Header="应用内 Blockly 编辑器"
                                       Description="实验性功能。启用后，点击「打开编辑器」会在应用内的独立视图中展示 Blockly 编辑器，而不是使用系统浏览器。">
                    <fa:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.EnableInAppBlocklyEditor}" />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>

                <!-- 安卓端没有文件关联与外部编辑器，强制使用应用内 JS 编辑器，故隐藏该开关 -->
                <fa:FASettingsExpander IconSource="{ci:FluentIconSource Glyph={ci:FI JavascriptRegular}}"
                                       Header="应用内 JS 编辑器"
                                       Description="实验性功能。启用后，JavaScript 行动的「打开编辑器」会在应用内编辑脚本；关闭时用系统默认程序打开脚本文件。安卓端强制启用。"
                                       IsVisible="{Binding !IsAndroid}">
                    <fa:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.EnableInAppJsEditor}" />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>

                <Separator Margin="0 12 0 4" />
                <ci:IconText Glyph="{ci:FI StorageRegular}" Text="存储管理" Margin="0 0 0 4" />

                <fa:FASettingsExpander IconSource="{ci:FluentIconSource Glyph={ci:FI StorageRegular}}"
                                       Header="脚本存储"
                                       Description="JS 脚本通过 localStorage 写下的数据。">
                    <WrapPanel Classes="animated-resize">
                        <TextBlock x:Name="StorageSummaryText"
                                   Margin="0 0 8 0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Button x:Name="ClearStorageButton" Click="ClearStorageButton_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ci:FluentIcon Glyph="{ci:FI BroomRegular}" FontSize="16" />
                                <TextBlock Text="清理数据" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </fa:FASettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ci:SettingsPageBase>