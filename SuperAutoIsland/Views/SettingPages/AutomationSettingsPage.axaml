<ci:SettingsPageBase x:Class="SuperAutoIsland.Views.SettingPages.AutomationSettingsPage"
                     x:Name="Page"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:controls="clr-namespace:SuperAutoIsland.Controls"
                     xmlns:local="clr-namespace:SuperAutoIsland.Views.SettingPages"
                     xmlns:models="clr-namespace:SuperAutoIsland.Models"
                     xmlns:enums="clr-namespace:SuperAutoIsland.Enums"
                     xmlns:converters="clr-namespace:SuperAutoIsland.Shared.Converters"
                     xmlns:ciControlsAutomation="clr-namespace:ClassIsland.Core.Controls.Automation;assembly=ClassIsland.Core"
                     x:DataType="local:AutomationSettingsPage"
                     mc:Ignorable="d">
    <ci:SettingsPageBase.Resources>
        <converters:ActionsToActionSetConverter x:Key="ActionsToActionSetConverter" />
    </ci:SettingsPageBase.Resources>

    <controls:ListDetailView Margin="12 12 0 0"
                             ShowTitleWhenNotCompressed="True"
                             IsPanelOpened="{Binding ViewModel.IsPanelOpened}">
        <controls:ListDetailView.LeftContent>
            <Grid RowDefinitions="Auto, Auto, *">
                <TextBlock Grid.Row="0"
                           FontWeight="Normal"
                           Text="SuperAutoIsland 自动化"
                           Theme="{StaticResource TitleTextBlockStyle}" />

                <StackPanel Grid.Row="1" Margin="0 6 0 0" Orientation="Horizontal">
                    <Button Theme="{StaticResource TransparentButton}"
                            ToolTip.Tip="新建 SAI 自动化..."
                            Classes.invert-foreground-accent="{Binding !!ViewModel.Projects.Count}">
                        <Button.Styles>
                            <Style Selector="Button.invert-foreground-accent">
                                <Setter Property="Theme" Value="{StaticResource TransparentButton}" />
                            </Style>
                            <Style
                                Selector="Button:not(.invert-foreground-accent) /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background"
                                        Value="{DynamicResource CustomizedAccentBarBackground1Brush}" />
                            </Style>
                        </Button.Styles>

                        <ci:IconText Glyph="&#xE689;" Text="新建..."
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

                        <Button.Flyout>
                            <fa:FAMenuFlyout ItemsSource="{Binding ProjectTypeNodes}">
                                <fa:FAMenuFlyout.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ProjectTypeNode}">
                                        <fa:FAMenuFlyoutItem Text="{Binding Name}"
                                                             Command="{Binding #Page.CreateProjectCommand}"
                                                             CommandParameter="{Binding Type}"
                                                             ToolTip.Tip="{Binding ToolTip}">
                                            <fa:FAMenuFlyoutItem.IconSource>
                                                <ci:FluentIconSource Glyph="{Binding IconGlyph}" />
                                            </fa:FAMenuFlyoutItem.IconSource>
                                        </fa:FAMenuFlyoutItem>
                                    </DataTemplate>
                                </fa:FAMenuFlyout.ItemTemplate>
                            </fa:FAMenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="2">
                    <ListBox ItemsSource="{Binding ViewModel.Projects}"
                             SelectedItem="{Binding ViewModel.SelectedProject, Mode=TwoWay}"
                             SelectionChanged="ProjectsListBox_OnSelectionChanged"
                             SelectionMode="Single">
                        <ListBox.Styles>
                            <Style Selector="ListBox:not(.no-drag) ListBoxItem">
                                <Setter Property="Interaction.Behaviors">
                                    <BehaviorCollectionTemplate>
                                        <BehaviorCollection>
                                            <ci:AdvancedItemDragBehavior HorizontalDragThreshold="21879066"
                                                                         Orientation="Vertical"
                                                                         VerticalDragThreshold="3" />
                                        </BehaviorCollection>
                                    </BehaviorCollectionTemplate>
                                </Setter>
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Classes="animated-intro" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent"
                                      ColumnDefinitions="Auto * Auto"
                                      Height="32">
                                    <!--  触摸拖动把手  -->
                                    <ci:TouchDragThumb Grid.Column="0"
                                                       Margin="-12 0 0 0"
                                                       Width="20" />

                                    <!--  Name  -->
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="{Binding Name}"
                                               FontSize="13"
                                               TextWrapping="Wrap" />

                                    <!--  Type  -->
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Text="{Binding Type, Converter={x:Static local:AutomationSettingsPage.ProjectsTypeNameConverter}}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </controls:ListDetailView.LeftContent>

        <controls:ListDetailView.TitleElement>
            <TextBlock FontWeight="Normal"
                       Text="项目设置"
                       IsVisible="{Binding ViewModel.IsPanelOpened}"
                       Theme="{StaticResource TitleTextBlockStyle}" />
        </controls:ListDetailView.TitleElement>

        <controls:ListDetailView.RightContent>
            <ci:Emptiable x:Name="RightEmptiable" Content="{Binding ViewModel.SelectedProject}">
                <ci:Emptiable.ContentTemplate>
                    <DataTemplate x:DataType="models:Project">
                        <ScrollViewer>
                            <StackPanel Orientation="Vertical" Classes="animated-intro">
                                <StackPanel.Styles>
                                    <Style Selector="StackPanel > Expander /template/ ToggleButton#ExpanderHeader">
                                        <Setter Property="Background"
                                                Value="{DynamicResource CustomizedAccentBarBackground1Brush}" />
                                    </Style>
                                    <Style Selector="StackPanel > Expander">
                                        <Setter Property="IsExpanded" Value="True" />
                                        <Setter Property="Margin" Value="2 2 2 10" />
                                    </Style>
                                </StackPanel.Styles>

                                <Expander Classes="compact stretch-header">
                                    <Expander.Header>
                                        <ci:IconText Glyph="&#xE9E4;" Text="项目信息" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Margin="2 0 0 0">
                                                <Run Text="项目类型:" />
                                                <Run Text="{Binding Type, Converter={x:Static local:AutomationSettingsPage.ProjectsTypeNameConverter}, Mode=OneWay}" />
                                            </TextBlock>
                                            
                                            <ci:Field Label="项目名称">
                                                <TextBox Text="{Binding Name}" />
                                            </ci:Field>
                                            
                                            <ci:Field Label="JS 文件 ID"
                                                      IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:ProjectsType.JavaScriptAction}}">
                                                <TextBox Text="{Binding JsId}" />
                                            </ci:Field>
                                            
                                            <Separator Margin="0 4" />
                                            
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Click="OpenProjectEditorButton_Click"
                                                        IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:ProjectsType.BlocklyAction}}">
                                                    <ci:IconText Glyph="&#xEC2E;" Text="打开编辑器" />
                                                </Button>

                                                <!-- JavaScript 行动：应用内编辑器（安卓端强制启用）或系统默认程序 -->
                                                <Button Click="OpenJavaScriptEditorButton_OnClick"
                                                        IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:ProjectsType.JavaScriptAction}}">
                                                    <ci:IconText Glyph="{ci:FI CodeRegular}" Text="打开编辑器" />
                                                </Button>

                                                <Button Click="OpenJavaScriptFolderButton_OnClick">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="Type"
                                                                     Converter="{x:Static ObjectConverters.Equal}"
                                                                     ConverterParameter="{x:Static enums:ProjectsType.JavaScriptAction}" />
                                                            <Binding Path="#Page.IsDesktop" />
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                    <ci:IconText Glyph="{ci:FI FolderOpenRegular}" Text="打开所在文件夹" />
                                                </Button>

                                                <Button Click="RunProjectButton_Click">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                            <Binding Path="Type"
                                                                     Converter="{x:Static ObjectConverters.Equal}"
                                                                     ConverterParameter="{x:Static enums:ProjectsType.BlocklyAction}" />
                                                            <Binding Path="Type"
                                                                     Converter="{x:Static ObjectConverters.Equal}"
                                                                     ConverterParameter="{x:Static enums:ProjectsType.JavaScriptAction}" />
                                                            <Binding Path="Type"
                                                                     Converter="{x:Static ObjectConverters.Equal}"
                                                                     ConverterParameter="{x:Static enums:ProjectsType.CiRuleset}" />
                                                            <Binding Path="Type"
                                                                     Converter="{x:Static ObjectConverters.Equal}"
                                                                     ConverterParameter="{x:Static enums:ProjectsType.CiActionSet}" />
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                    <ci:IconText Glyph="&#xEDBF;" Text="试运行" />
                                                </Button>

                                                <Button>
                                                    <ci:IconText Glyph="&#xE61D;" Text="删除" Foreground="IndianRed" />

                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="8">
                                                                <TextBlock FontWeight="Bold">
                                                                    <Run Text="要删除项目「" />
                                                                    <Run Text="{Binding Name}" />
                                                                    <Run Text="」吗？" />
                                                                </TextBlock>
                                                                <TextBlock Text="此操作无法撤销。" />
                                                                <Button Content="删除" Classes="accent"
                                                                        Click="DeleteProjectButton_Click" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander Classes="compact stretch-header"
                                          IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:ProjectsType.CiRuleset}}">
                                    <Expander.Header>
                                        <ci:IconText Glyph="&#xF17E;" Text="规则集" />
                                    </Expander.Header>
                                    <ci:RulesetControl Ruleset="{Binding Ruleset}" ShowTitle="False" />
                                </Expander>

                                <Expander Classes="compact stretch-header"
                                          IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:ProjectsType.CiActionSet}}">
                                    <Expander.Header>
                                        <ci:IconText Glyph="&#xE01F;" Text="行动组" />
                                    </Expander.Header>
                                    <ciControlsAutomation:ActionControl
                                        ActionSet="{Binding Converter={StaticResource ActionsToActionSetConverter}, Mode=TwoWay}" />
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>
                </ci:Emptiable.ContentTemplate>

                <ci:Emptiable.EmptyContent>
                    <StackPanel VerticalAlignment="Center">
                        <ci:StickerControl Width="75" Height="75"
                                           StickerSource="avares://ClassIsland/Assets/HoYoStickers/光辉矢愿_瞄准.png"
                                           StickerToolTip="光辉矢愿_瞄准"
                                           FallbackIcon="{ci:FluentIconSource &#xEEF1;, FontSize=75}" />

                        <TextBlock Text="在左侧选择或添加一个自动化，然后在此处进行设置。"
                                   Margin="0 8 0 0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </ci:Emptiable.EmptyContent>
            </ci:Emptiable>
        </controls:ListDetailView.RightContent>
    </controls:ListDetailView>
</ci:SettingsPageBase>