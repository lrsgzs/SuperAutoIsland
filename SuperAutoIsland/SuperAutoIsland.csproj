<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDynamicLoading>True</EnableDynamicLoading>
        <RootNamespace>SuperAutoIsland</RootNamespace>
        <Version>0.1.4.0</Version>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>lrs2187</Authors>
        <PackageVersion>0.1.4.0</PackageVersion>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1">
            <ExcludeAssets>runtime; native</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Jint" Version="4.14.0" />
        <ProjectReference Include="..\SuperAutoIsland.Interface\SuperAutoIsland.Interface.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets/icon.png" />
    </ItemGroup>
    
    <ItemGroup>
        <None Update="manifest.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="README.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        
        <Content Include="Assets/wwwroot/**/*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        
        <None Update="Assets\icon.png">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    
    
    <ItemGroup>
      <Compile Update="Views\SaiLogsView.axaml.cs">
        <DependentUpon>SaiLogsWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>
    
    
    <ItemGroup>
      <AdditionalFiles Include="Views\SaiLogsWindow.axaml" />
      <AdditionalFiles Include="Views\SettingPages\AboutSettingsPage.axaml" />
      <AdditionalFiles Include="Views\SettingPages\AutomationSettingsPage.axaml" />
      <AdditionalFiles Include="Views\SettingPages\MainSettingsPage.axaml" />
    </ItemGroup>
    
    
    <ItemGroup>
      <UpToDateCheckInput Remove="Controls\SettingPages\AboutSettingsPage.axaml" />
      <UpToDateCheckInput Remove="Controls\SettingPages\AutomationSettingsPage.axaml" />
      <UpToDateCheckInput Remove="Controls\SettingPages\MainSettingsPage.axaml" />
    </ItemGroup>
</Project>